# Test Results
**/TestResults/*.html
**/TestResults/*.xml

# PowerShell logs
*.log
*.transcript.log

# Module output
**/ProgramData/

# Generated deployment parameter files (contain environment-specific values)
**/deployment-parameter-files/

# IDE
.vscode/settings.json
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
~$*

# Agent scratch files (never commit)
_tmp_*

# Local-only test/utility scripts (never commit)
AzLocal.UpdateManagement/Test-Pipelines.ps1

# Agent-generated planning / review docs (kept locally, never committed)
# Per-module consolidation folder (preferred location for all review artefacts):
AzLocal.UpdateManagement/Module-reviews/
# Defensive guards for stray files anywhere in the tree:
**/COMBINED-REVIEW-ACTION-PLAN.md
**/MODULE-REVIEW-AND-RECOMMENDATIONS.md

